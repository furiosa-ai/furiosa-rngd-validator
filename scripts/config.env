#!/bin/bash
# Tunable defaults for the validation phase scripts.
# Sourced by each phase script; pre-existing environment values take precedence.

# P2P benchmark
P2P_BUFFER_SIZE="${P2P_BUFFER_SIZE:-16MiB}"
# Restrict which ACS sequence the p2p phase benchmarks: "disable" or "enable"
# only. Empty (default) runs both, disable then enable, and restores ACS to its
# pre-run state on exit. A single-mode run does NOT restore -- it deliberately
# leaves ACS in the requested state (so "disable" leaves ACS disabled).
P2P_ACS_MODE="${P2P_ACS_MODE:-}"

# Allgather benchmark. Comma-separated NPU group sizes; the phase runs
# `furiosa-hal-bench allgather` once per group (see common.sh npu_groups for the
# grouping rule). A group size larger than the selected NPU count is skipped.
ALLGATHER_GROUP_SIZES="${ALLGATHER_GROUP_SIZES:-4}"
ALLGATHER_BUFFER_SIZE="${ALLGATHER_BUFFER_SIZE:-1MiB}"

# Stress test
STRESS_BASE_PORT="${STRESS_BASE_PORT:-8000}"
# Comma-separated NPU indices targeted by the diag, p2p, allgather, and stress phases (e.g. VALIDATE_NPUS=0,2). Defaults to all detected NPUs.
VALIDATE_NPUS="${VALIDATE_NPUS:-}"
# Fail fast on a malformed override at load time. Requires common.sh (sourced
# before config.env by every phase); guarded so config.env stays usable alone.
declare -F normalize_validate_npus >/dev/null && normalize_validate_npus
STRESS_REVISION="${STRESS_REVISION:-v2026.2}"
# Comma-separated list of models; each entry is name:org.
STRESS_MODELS="${STRESS_MODELS:-Llama-3.1-8B-Instruct:meta-llama,Qwen2.5-0.5B-Instruct:Qwen}"
# Comma-separated list of triples; each entry is in_len:out_len:concurrency.
STRESS_RANDOM_TRIPLES="${STRESS_RANDOM_TRIPLES:-1024:1024:128,2048:1024:64,4096:1024:32,6144:1024:16,12288:1024:8,31744:1024:1}"

# Service-readiness wait (used by run_stress.sh check_models_up)
SERVE_READY_MAX_ATTEMPTS="${SERVE_READY_MAX_ATTEMPTS:-30}"
SERVE_READY_INTERVAL="${SERVE_READY_INTERVAL:-60}"

# Sensor monitor (used by lib/sensor_monitor.py via --interval)
SENSOR_POLL_INTERVAL="${SENSOR_POLL_INTERVAL:-1}"

# Python virtualenvs.  The Dockerfile bakes these paths in; override when
# running outside the container.
FURIOSA_VENV="${FURIOSA_VENV:-/opt/furiosa_venv}"
VLLM_VENV="${VLLM_VENV:-/opt/vllm_venv}"
